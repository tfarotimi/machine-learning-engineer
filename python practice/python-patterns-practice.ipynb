   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Good Code: Unpacking\n",
    "batch = ([1, 2, 3], [0, 1, 0], {'size': 3})\n",
    "\n",
    "features, labels, metadata = batch\n",
    "\n",
    "print(f\"Features: {features}, Labels: {labels}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Unpacking with rest (_ or *rest)\n",
    "batch = ([1, 2, 3], [0, 1, 0], {'size': 3}, 'extra1', 'extra2')\n",
