   "source": [
    "# **kwargs: Variable keyword arguments\n",
    "def create_config(**settings):\n",
    "    \"\"\"Build a config from any number of keyword arguments.\"\"\"\n",
    "    return settings\n",
    "\n",
    "config1 = create_config(learning_rate=0.01, batch_size=32)\n",
    "print(config1)\n",
    "\n",
    "config2 = create_config(learning_rate=0.001, epochs=100, verbose=True)\n",
