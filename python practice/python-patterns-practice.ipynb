    "---\n",
    "## Pattern 13: Avoiding Mutable Defaults (Recap & Deep Dive)\n",
    "\n",
    "We saw this in Pattern 4, but it's important enough to revisit with more examples.\n",
    "\n",
    "### The Real Trap"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# This is a real bug that happens in neural networks:\n",
    "class Layer:\n",
    "    def __init__(self, size, activations=[]):\n",
    "        self.size = size\n",
    "        self.activations = activations  # TRAP!\n",
    "\n",
    "layer1 = Layer(10)\n",
    "layer1.activations.append('relu')\n",
    "\n",
    "layer2 = Layer(20)\n",
    "print(layer2.activations)  # SURPRISE: ['relu'] (shared with layer1!)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fix: Use None\n",
    "class Layer:\n",
    "    def __init__(self, size, activations=None):\n",
    "        self.size = size\n",
    "        self.activations = activations if activations is not None else []\n",
    "\n",
    "layer1 = Layer(10)\n",
    "layer1.activations.append('relu')\n",
    "\n",
    "layer2 = Layer(20)\n",
    "print(layer2.activations)  # Now correct: []"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Your Turn: Practice\n",
    "\n",
    "Find and fix the bug in this code:\n",
    "\n",
    "```python\n",
    "def train_network(model, data, labels, optimizer_state={}):\n",
    "    optimizer_state['step'] = optimizer_state.get('step', 0) + 1\n",
    "    # ... training code ...\n",
    "    return optimizer_state\n",
    "\n",
    "state1 = train_network(model, X1, y1)\n",
    "state2 = train_network(model, X2, y2)\n",
    "print(state2['step'])  # What do you expect? What do you get?\n",
    "```"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Show the bug\n",
    "def train_network_BUGGY(model, data, labels, optimizer_state={}):\n",
    "    optimizer_state['step'] = optimizer_state.get('step', 0) + 1\n",
    "    return optimizer_state\n",
    "\n",
    "state1 = train_network_BUGGY(None, None, None)\n",
    "print(f\"After first call: {state1}\")\n",
    "\n",
    "state2 = train_network_BUGGY(None, None, None)\n",
    "print(f\"After second call: {state2}\")\n",
    "\n",
    "# Now fix it\n",
    "def train_network_FIXED(model, data, labels, optimizer_state=None):\n",
    "    if optimizer_state is None:\n",
    "        optimizer_state = {}\n",
    "    optimizer_state['step'] = optimizer_state.get('step', 0) + 1\n",
    "    return optimizer_state\n",
    "\n",
    "state1 = train_network_FIXED(None, None, None)\n",
    "print(f\"After first call (fixed): {state1}\")\n",
    "\n",
    "state2 = train_network_FIXED(None, None, None)\n",
    "print(f\"After second call (fixed): {state2}\")"
   ]
