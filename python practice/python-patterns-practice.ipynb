    "---\n",
    "## Pattern 15: Assertions for Validation\n",
    "\n",
    "### Why You Care\n",
    "Neural networks are easy to break silently (wrong shapes, NaNs, etc.). Assertions catch bugs early."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Good Code: Use assertions to validate assumptions\n",
    "def forward_pass(X, weights):\n",
    "    assert X.shape[1] == weights.shape[0], f\"Shape mismatch: X has {X.shape[1]} features but weights expect {weights.shape[0]}\"\n",
    "    assert not np.isnan(X).any(), \"X contains NaN values!\"\n",
    "    assert not np.isinf(X).any(), \"X contains infinite values!\"\n",
    "    \n",
    "    output = X @ weights\n",
    "    return output\n",
    "\n",
    "# This will catch errors immediately\n",
    "X = np.random.randn(10, 5)\n",
    "W = np.random.randn(5, 3)\n",
    "output = forward_pass(X, W)\n",
    "print(f\"Output shape: {output.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "# FINAL PROJECTS: PUT IT ALL TOGETHER\n",
    "\n",
    "Now that you've practiced individual patterns, it's time to **combine them**. Here are mini-projects that use multiple patterns:\n",
    "\n",
    "## Project: Build a Simple Batch Loader Class\n",
    "\n",
    "Requirements:\n",
    "- Uses `__init__` properly\n",
    "- Uses `@property` for computed attributes\n",
    "- Uses generators to yield batches\n",
    "- Uses type validation with assertions\n",
    "- Uses keyword-only arguments"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class BatchLoader:\n",
    "    \"\"\"Memory-efficient batch loader for training.\"\"\"\n",
    "    \n",
    "    def __init__(self, X, y, *, batch_size=32, shuffle=True):\n",
    "        \"\"\"\n",
    "        Args:\n",
    "            X: Feature array (n_samples, n_features)\n",
    "            y: Labels array (n_samples,)\n",
    "            batch_size: Batch size (keyword-only)\n",
    "            shuffle: Whether to shuffle data\n",
    "        \"\"\"\n",
    "        assert X.shape[0] == y.shape[0], \"X and y must have same number of samples\"\n",
    "        assert batch_size > 0, \"batch_size must be positive\"\n",
    "        \n",
    "        self.X = X\n",
    "        self.y = y\n",
    "        self.batch_size = batch_size\n",
    "        self.shuffle = shuffle\n",
    "    \n",
    "    @property\n",
    "    def num_batches(self):\n",
    "        \"\"\"Compute number of batches.\"\"\"\n",
    "        return (len(self.X) + self.batch_size - 1) // self.batch_size\n",
    "    \n",
    "    @property\n",
    "    def num_samples(self):\n",
    "        \"\"\"Total number of samples.\"\"\"\n",
    "        return len(self.X)\n",
    "    \n",
    "    def __repr__(self):\n",
    "        return f\"BatchLoader(samples={self.num_samples}, batch_size={self.batch_size}, batches={self.num_batches})\"\n",
    "    \n",
    "    def batches(self):\n",
    "        \"\"\"Generator that yields batches.\"\"\"\n",
    "        indices = np.arange(len(self.X))\n",
    "        if self.shuffle:\n",
    "            np.random.shuffle(indices)\n",
    "        \n",
    "        for i in range(0, len(self.X), self.batch_size):\n",
    "            batch_indices = indices[i:i + self.batch_size]\n",
    "            X_batch = self.X[batch_indices]\n",
    "            y_batch = self.y[batch_indices]\n",
    "            yield X_batch, y_batch\n",
    "\n",
    "# Test it!\n",
    "X = np.random.randn(100, 10)\n",
    "y = np.random.randint(0, 2, 100)\n",
    "\n",
    "loader = BatchLoader(X, y, batch_size=16)\n",
    "print(loader)\n",
    "\n",
    "for X_batch, y_batch in loader.batches():\n",
    "    print(f\"Batch: X{X_batch.shape}, y{y_batch.shape}\")\n",
    "    if X_batch.shape[0] == 16:  # After first batch\n",
    "        break"
   ]
