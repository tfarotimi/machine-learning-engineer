   "source": [
    "# Unpacking a list with *\n",
    "def add(a, b, c):\n",
    "    return a + b + c\n",
    "\n",
    "numbers = [1, 2, 3]\n",
    "result = add(*numbers)  # Unpacks list into separate arguments\n",
    "print(result)\n",
    "\n",
    "# Unpacking a dict with **\n",
    "def train(learning_rate=0.01, batch_size=32, epochs=100):\n",
    "    print(f\"Training: lr={learning_rate}, bs={batch_size}, epochs={epochs}\")\n",
    "\n",
    "config = {'learning_rate': 0.001, 'batch_size': 64}\n",
    "train(**config)  # Unpacks dict into keyword arguments"
