   "source": [
    "# Demonstrate the difference\n",
    "arr1 = np.array([1, 2, 3, 4, 5])\n",
    "arr1[0:2] = [10, 20]\n",
    "print(f\"Slice assignment: {arr1}\")\n",
    "\n",
    "arr2 = np.array([1, 2, 3, 4, 5])\n",
